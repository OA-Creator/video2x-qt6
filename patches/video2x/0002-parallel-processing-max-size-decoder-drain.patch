+// Runs one unit of work on a processor and returns the frames to write, in order.
+// For filters this is the filtered frame. For interpolators this is the interpolated
+// frames between prev_frame and frame, followed by frame itself.
+int VideoProcessor::run_processor(
+    processors::Processor* processor,
+    AVFrame* prev_frame,
+    AVFrame* frame,
+    std::vector<AVFrame*>& out_frames
+) {
+    char errbuf[AV_ERROR_MAX_STRING_SIZE];
+    int ret = 0;
+
+    if (processor->get_processing_mode() == processors::ProcessingMode::Filter) {
+        processors::Filter* filter = static_cast<processors::Filter*>(processor);
+
+        // Shrink the input first in the faster modes
+        std::unique_ptr<AVFrame, decltype(&avutils::av_frame_deleter)> prescaled(
+            prescale_frame(frame), &avutils::av_frame_deleter
+        );
+        if (prescaled != nullptr) {
+            frame = prescaled.get();
+        }
+
+        AVFrame* proc_frame = nullptr;
+        ret = filter->filter(frame, &proc_frame);
+        if (ret < 0 && ret != AVERROR(EAGAIN)) {
+            av_strerror(ret, errbuf, sizeof(errbuf));
+            logger()->critical("Error filtering frame: {}", errbuf);
+            return ret;
+        }
+        if (ret == 0 && proc_frame != nullptr) {
+            out_frames.push_back(proc_frame);
+        }
+        return 0;
+    }
+
+    processors::Interpolator* interpolator = static_cast<processors::Interpolator*>(processor);
+
+    if (prev_frame != nullptr) {
+        // Check if a scene change is detected
+        bool skip_frame = false;
+        if (proc_cfg_.scn_det_thresh < 100.0) {
+            float frame_diff = avutils::get_frame_diff(prev_frame, frame);
+            if (frame_diff > proc_cfg_.scn_det_thresh) {
+                logger()->debug("Scene change detected ({:.2f}%)", frame_diff);
+                skip_frame = true;
+            }
+        }
+
+        float time_step = 1.0f / static_cast<float>(proc_cfg_.frm_rate_mul);
+        float current_time_step = time_step;
+        for (int i = 0; i < proc_cfg_.frm_rate_mul - 1; i++) {
+            AVFrame* proc_frame = nullptr;
+            if (!skip_frame) {
+                ret = interpolator->interpolate(prev_frame, frame, &proc_frame, current_time_step);
+            } else {
+                ret = 0;
+                proc_frame = av_frame_clone(prev_frame);
+            }
+
+            if (ret < 0 && ret != AVERROR(EAGAIN)) {
+                av_strerror(ret, errbuf, sizeof(errbuf));
+                logger()->critical("Error interpolating frame: {}", errbuf);
+                return ret;
+            }
+            if (ret == 0 && proc_frame != nullptr) {
+                out_frames.push_back(proc_frame);
+            }
+            current_time_step += time_step;
+        }
+    }
+
+    // The original frame follows the interpolated frames
+    AVFrame* original = av_frame_clone(frame);
+    if (original == nullptr) {
+        return AVERROR(ENOMEM);
+    }
+    out_frames.push_back(original);
+    return 0;
+}
