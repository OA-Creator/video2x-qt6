+// Process frames with several processor instances at once.
+// The main thread decodes, worker threads run the processors and a writer thread
+// encodes the results in their original order.
+int VideoProcessor::process_frames_parallel(
+    decoder::Decoder& decoder,
+    encoder::Encoder& encoder,
+    std::vector<std::unique_ptr<processors::Processor>>& processors
+) {
+    char errbuf[AV_ERROR_MAX_STRING_SIZE];
+    int ret = 0;
+
+    AVFormatContext* ifmt_ctx = decoder.get_format_context();
+    AVCodecContext* dec_ctx = decoder.get_codec_context();
+    int in_vstream_idx = decoder.get_video_stream_index();
+    AVFormatContext* ofmt_ctx = encoder.get_format_context();
+    AVCodecContext* enc_ctx = encoder.get_encoder_context();
+    int* stream_map = encoder.get_stream_map();
+    bool interpolate =
+        processors.front()->get_processing_mode() == processors::ProcessingMode::Interpolate;
+
+    // Estimate the total number of frames
+    total_frames_ = avutils::get_video_frame_count(ifmt_ctx, in_vstream_idx);
+    if (total_frames_ <= 0) {
+        logger()->warn("Unable to determine the total number of frames");
+        total_frames_ = 0;
+    } else if (interpolate) {
+        total_frames_.store(total_frames_.load() * proc_cfg_.frm_rate_mul);
+    }
+
+    struct WorkItem {
+        int64_t seq = 0;
+        AVFrame* prev_frame = nullptr;
+        AVFrame* frame = nullptr;
+    };
+
+    const size_t worker_count = processors.size();
+    BoundedQueue<WorkItem> work_queue(worker_count * 2);
+
+    // Results keyed by sequence number, consumed in order by the writer
+    std::mutex results_mutex;
+    std::condition_variable results_cv;
+    std::map<int64_t, std::vector<AVFrame*>> results;
+    size_t workers_running = worker_count;
+    std::atomic<int> error_code = 0;
+
+    auto fail = [&](int code) {
+        int expected = 0;
+        error_code.compare_exchange_strong(expected, code);
+        work_queue.close();
+        std::lock_guard<std::mutex> lock(results_mutex);
+        results_cv.notify_all();
+    };
+
+    auto free_item = [](WorkItem& item) {
+        av_frame_free(&item.prev_frame);
+        av_frame_free(&item.frame);
+    };
+
+    // Worker threads
+    std::vector<std::thread> workers;
+    for (size_t w = 0; w < worker_count; ++w) {
+        workers.emplace_back([&, w] {
+            WorkItem item;
+            while (work_queue.pop(item)) {
+                std::vector<AVFrame*> out_frames;
+                int wret = 0;
+                if (error_code.load() == 0) {
+                    wret = run_processor(
+                        processors[w].get(), item.prev_frame, item.frame, out_frames
+                    );
+                }
+
+                // Scale down here so that the writer thread only has to encode
+                for (AVFrame*& f : out_frames) {
+                    if (wret < 0) {
+                        break;
+                    }
+                    if (f->width != enc_ctx->width || f->height != enc_ctx->height) {
+                        AVFrame* scaled = conversions::scale_avframe(
+                            f, enc_ctx->width, enc_ctx->height, enc_ctx->pix_fmt
+                        );
+                        if (scaled == nullptr) {
+                            wret = AVERROR(ENOMEM);
+                            break;
+                        }
+                        av_frame_free(&f);
+                        f = scaled;
+                    }
+                }
+                free_item(item);
+                if (wret < 0) {
+                    for (AVFrame* f : out_frames) {
+                        av_frame_free(&f);
+                    }
+                    fail(wret);
+                    continue;
+                }
+                std::lock_guard<std::mutex> lock(results_mutex);
+                results.emplace(item.seq, std::move(out_frames));
+                results_cv.notify_all();
+            }
+            std::lock_guard<std::mutex> lock(results_mutex);
+            workers_running--;
+            results_cv.notify_all();
+        });
+    }
+
+    // Writer thread
+    std::thread writer([&] {
+        int64_t next_seq = 0;
+        while (true) {
+            std::vector<AVFrame*> out_frames;
+            {
+                std::unique_lock<std::mutex> lock(results_mutex);
+                results_cv.wait(lock, [&] {
+                    return results.count(next_seq) > 0 || workers_running == 0 ||
+                           error_code.load() != 0;
+                });
+                auto it = results.find(next_seq);
+                if (it == results.end()) {
+                    // Either all work is done or an error occurred
+                    break;
+                }
+                out_frames = std::move(it->second);
+                results.erase(it);
+            }
+            next_seq++;
+
+            for (AVFrame* f : out_frames) {
+                int wret = 0;
+                if (error_code.load() == 0) {
+                    std::lock_guard<std::mutex> lock(mux_mutex_);
+                    wret = write_frame(f, encoder);
+                }
+                av_frame_free(&f);
+                if (wret < 0) {
+                    fail(wret);
+                } else {
+                    frame_idx_.fetch_add(1);
+                }
+            }
+        }
+    });
+
+    // Decode frames on this thread
+    std::unique_ptr<AVFrame, decltype(&avutils::av_frame_deleter)> frame(
+        av_frame_alloc(), &avutils::av_frame_deleter
+    );
+    std::unique_ptr<AVPacket, decltype(&avutils::av_packet_deleter)> packet(
+        av_packet_alloc(), &avutils::av_packet_deleter
+    );
+    if (frame == nullptr || packet == nullptr) {
+        fail(AVERROR(ENOMEM));
+    }
+
+    AVFrame* prev_frame = nullptr;
+    int64_t seq = 0;
+    int64_t decoded_idx = 0;
+
+    while (error_code.load() == 0 && state_.load() != VideoProcessorState::Aborted) {
+        ret = av_read_frame(ifmt_ctx, packet.get());
+        bool draining = false;
+        if (ret == AVERROR_EOF) {
+            // Send an empty packet to drain the frames still buffered in the decoder
+            logger()->debug("Reached end of file, draining decoder");
+            draining = true;
+        } else if (ret < 0) {
+            av_strerror(ret, errbuf, sizeof(errbuf));
+            logger()->critical("Error reading packet: {}", errbuf);
+            fail(ret);
+            break;
+        }
+
+        if (draining || packet->stream_index == in_vstream_idx) {
+            ret = avcodec_send_packet(dec_ctx, draining ? nullptr : packet.get());
+            if (ret < 0) {
+                av_strerror(ret, errbuf, sizeof(errbuf));
+                logger()->critical("Error sending packet to decoder: {}", errbuf);
+                fail(ret);
+                break;
+            }
+
+            while (error_code.load() == 0 && state_.load() != VideoProcessorState::Aborted) {
+                if (state_.load() == VideoProcessorState::Paused) {
+                    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+                    continue;
+                }
+
+                ret = avcodec_receive_frame(dec_ctx, frame.get());
+                if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) {
+                    ret = 0;
+                    break;
+                } else if (ret < 0) {
+                    av_strerror(ret, errbuf, sizeof(errbuf));
+                    logger()->critical("Error decoding video frame: {}", errbuf);
+                    fail(ret);
+                    break;
+                }
+
+                // Calculate this frame's presentation timestamp (PTS)
+                if (enc_cfg_.recalculate_pts) {
+                    int64_t pts_idx = interpolate ? decoded_idx * proc_cfg_.frm_rate_mul
+                                                  : decoded_idx;
+                    frame->pts =
+                        av_rescale_q(pts_idx, av_inv_q(enc_ctx->framerate), enc_ctx->time_base);
+                }
+                decoded_idx++;
+
+                WorkItem item;
+                item.seq = seq++;
+                item.frame = av_frame_clone(frame.get());
+                if (interpolate && prev_frame != nullptr) {
+                    item.prev_frame = av_frame_clone(prev_frame);
+                }
+                if (interpolate) {
+                    av_frame_free(&prev_frame);
+                    prev_frame = av_frame_clone(frame.get());
+                }
+                av_frame_unref(frame.get());
+
+                if (item.frame == nullptr) {
+                    free_item(item);
+                    fail(AVERROR(ENOMEM));
+                    break;
+                }
+                if (!work_queue.push(item)) {
+                    free_item(item);
+                    break;
+                }
+            }
+        } else if ((enc_cfg_.copy_audio_streams || enc_cfg_.copy_subtitle_streams) &&
+                   stream_map[packet->stream_index] >= 0) {
+            std::lock_guard<std::mutex> lock(mux_mutex_);
+            ret = write_raw_packet(packet.get(), ifmt_ctx, ofmt_ctx, stream_map);
+            if (ret < 0) {
+                fail(ret);
+            }
+        }
+        av_packet_unref(packet.get());
+        if (draining) {
+            break;
+        }
+    }
+    av_frame_free(&prev_frame);
+
+    // No more work: let the workers finish and the writer drain the results
+    work_queue.close();
+    for (std::thread& t : workers) {
+        t.join();
+    }
+    {
+        std::lock_guard<std::mutex> lock(results_mutex);
+        results_cv.notify_all();
+    }
+    writer.join();
+
+    // Free any results that were not written because of an error
+    for (auto& [result_seq, out_frames] : results) {
+        for (AVFrame* f : out_frames) {
+            av_frame_free(&f);
+        }
+    }
+
+    if (error_code.load() != 0) {
+        return error_code.load();
+    }
+
+    // Flush the encoder
+    ret = encoder.flush();
+    if (ret < 0) {
+        av_strerror(ret, errbuf, sizeof(errbuf));
+        logger()->critical("Error flushing encoder: {}", errbuf);
+        return ret;
+    }
+
+    return 0;
+}
+
+AVFrame* VideoProcessor::prescale_frame(AVFrame* frame) const {
+    if (prescale_width_ <= 0 || prescale_height_ <= 0 || frame->hw_frames_ctx != nullptr ||
+        (frame->width == prescale_width_ && frame->height == prescale_height_)) {
+        return nullptr;
+    }
+    return conversions::scale_avframe(
+        frame, prescale_width_, prescale_height_, static_cast<AVPixelFormat>(frame->format)
+    );
+}
