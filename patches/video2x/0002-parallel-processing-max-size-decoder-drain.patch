+AVFrame* scale_avframe(AVFrame* src_frame, int width, int height, AVPixelFormat pix_fmt) {
+    AVFrame* dst_frame = av_frame_alloc();
+    if (dst_frame == nullptr) {
+        logger()->error("Failed to allocate destination AVFrame.");
+        return nullptr;
+    }
+
+    dst_frame->format = pix_fmt;
+    dst_frame->width = width;
+    dst_frame->height = height;
+    if (av_frame_get_buffer(dst_frame, 32) < 0) {
+        logger()->error("Failed to allocate memory for AVFrame.");
+        av_frame_free(&dst_frame);
+        return nullptr;
+    }
+    av_frame_copy_props(dst_frame, src_frame);
+
+    // Each thread keeps its own context, it is only rebuilt when the sizes change
+    thread_local SwsContext* sws_ctx = nullptr;
+    sws_ctx = sws_getCachedContext(
+        sws_ctx,
+        src_frame->width,
+        src_frame->height,
+        static_cast<AVPixelFormat>(src_frame->format),
+        width,
+        height,
+        pix_fmt,
+        SWS_LANCZOS | SWS_ACCURATE_RND | SWS_FULL_CHR_H_INT,
+        nullptr,
+        nullptr,
+        nullptr
+    );
+    if (sws_ctx == nullptr) {
+        logger()->error("Failed to initialize swscale context.");
+        av_frame_free(&dst_frame);
+        return nullptr;
+    }
+
+    sws_scale(
+        sws_ctx,
+        src_frame->data,
+        src_frame->linesize,
+        0,
+        src_frame->height,
+        dst_frame->data,
+        dst_frame->linesize
+    );
+    return dst_frame;
+}
+
+void fit_dimensions(int& width, int& height, int max_width, int max_height) {
+    if (max_width <= 0 || max_height <= 0 || width <= 0 || height <= 0) {
+        return;
+    }
+
+    // Turn the box for portrait videos
+    if ((height > width) != (max_height > max_width)) {
+        std::swap(max_width, max_height);
+    }
+    if (width <= max_width && height <= max_height) {
+        return;
+    }
+
+    double factor = (std::min)(
+        static_cast<double>(max_width) / width, static_cast<double>(max_height) / height
+    );
+    width = (std::max)(2, static_cast<int>(std::floor(width * factor / 2.0)) * 2);
+    height = (std::max)(2, static_cast<int>(std::floor(height * factor / 2.0)) * 2);
+}
+
